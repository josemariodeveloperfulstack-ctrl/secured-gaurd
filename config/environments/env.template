# ===================== CONFIGURAÇÃO DE AMBIENTE =====================
# Copie este arquivo para .env.local, .env.dev, .env.staging, .env.prod
# e ajuste os valores conforme necessário

ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=dev

# ===================== BANCO DE DADOS =====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=secured_guard_dev
POSTGRES_USER=postgressg
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# ===================== REDIS CACHE =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ===================== JWT CONFIGURATION =====================
JWT_SECRET=CHANGE_THIS_JWT_SECRET_TO_AT_LEAST_256_BITS
JWT_EXPIRATION=604800000
JWT_REFRESH_EXPIRATION=604800000

# ===================== EMAIL CONFIGURATION =====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=securedguard@z7design.com.br

# ===================== SERVER CONFIGURATION =====================
SERVER_PORT=8081
SERVER_ADDRESS=0.0.0.0

# ===================== LOGGING CONFIGURATION =====================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# ===================== FLYWAY CONFIGURATION =====================
FLYWAY_ENABLED=true
FLYWAY_CLEAN_DISABLED=false
FLYWAY_OUT_OF_ORDER=true
FLYWAY_VALIDATE_ON_MIGRATE=true

# ===================== SECURITY CONFIGURATION =====================
# Configurações de segurança adicionais
SECURITY_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ===================== UPLOAD CONFIGURATION =====================
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=100MB

# ===================== DATABASE POOL CONFIGURATION =====================
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=20000
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=1200000

# ===================== CACHE CONFIGURATION =====================
CACHE_TYPE=caffeine
CACHE_MAX_SIZE=500
CACHE_EXPIRE_AFTER_WRITE=600

# ===================== DEVELOPMENT SPECIFIC =====================
# Apenas para desenvolvimento - NÃO usar em produção
DEV_SHOW_SQL=true
DEV_FORMAT_SQL=true
DEV_HIBERNATE_DDL_AUTO=update

# ===================== PRODUCTION SPECIFIC =====================
# Apenas para produção
PROD_SHOW_SQL=false
PROD_FORMAT_SQL=false
PROD_HIBERNATE_DDL_AUTO=validate
PROD_LOG_LEVEL_ROOT=WARN
PROD_LOG_LEVEL_APP=INFO
