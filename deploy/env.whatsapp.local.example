# =============================================================================
# WHATSAPP — DESENVOLVIMENTO LOCAL (Windows)
# =============================================================================
# Como usar:
#   1. Copie este arquivo para a raiz do projeto ou use como referência no IntelliJ
#   2. Preencha os valores marcados com <PREENCHER>
#   3. No IntelliJ: Run → Edit Configurations → Environment variables → colar
#      OU defina no PowerShell antes de subir o backend
#
# Documentação completa: docs/WHATSAPP_AGENTE_CONFIGURACAO.md
# =============================================================================

SPRING_PROFILES_ACTIVE=local

# --- Ordem de fallback (local: Evolution primeiro) ---
WHATSAPP_PROVIDER_ORDER=evolution,baileys

# --- Evolution API (padrão) ---
EVOLUTION_API_ENABLED=true
EVOLUTION_API_URL=https://evolution.z7botsolutions.com.br
EVOLUTION_API_KEY=<PREENCHER>
EVOLUTION_API_INSTANCE=securedguard

# --- Baileys REST (fallback: docker compose -f docker-compose.local.yml up -d whatsapp) ---
BAILEYS_ENABLED=true
BAILEYS_REST_URL=http://localhost:3333
BAILEYS_INSTANCE_KEY=secured_guard_local
BAILEYS_REST_TOKEN=

# --- UAZAPI (opcional — SaaS) ---
UAZAPI_ENABLED=false
UAZAPI_BASE_URL=<PREENCHER>
UAZAPI_INSTANCE_TOKEN=<PREENCHER>
UAZAPI_ADMIN_TOKEN=

# --- Z-API (opcional — SaaS) ---
ZAPI_ENABLED=false
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=<PREENCHER>
ZAPI_INSTANCE_TOKEN=<PREENCHER>
ZAPI_CLIENT_TOKEN=<PREENCHER>

# --- Agente IA (opcional) ---
GEMINI_API_ENABLED=false
GEMINI_API_KEY=<PREENCHER>
WHATSAPP_AGENT_AI_ENABLED=false
WHATSAPP_AGENT_AI_MODEL=gemini-1.5-flash
WHATSAPP_AGENT_CONTEXT_MAX_MESSAGES=40
