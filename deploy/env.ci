# ===================== CONFIGURAÇÃO CI =====================
ENVIRONMENT=test
SPRING_PROFILES_ACTIVE=test

# ===================== BANCO DE DADOS =====================
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=secured_guard_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===================== REDIS CACHE =====================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ===================== JWT CONFIGURATION =====================
JWT_SECRET=ci_jwt_secret_2024_secured_guard_test_environment_key_must_be_64_chars_long_for_hs512_security_compliance
JWT_EXPIRATION=604800000
JWT_REFRESH_EXPIRATION=604800000

# ===================== SERVER CONFIGURATION =====================
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# ===================== LOGGING CONFIGURATION =====================
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO

# ===================== FLYWAY CONFIGURATION =====================
FLYWAY_ENABLED=true
FLYWAY_CLEAN_DISABLED=false
FLYWAY_OUT_OF_ORDER=true
FLYWAY_VALIDATE_ON_MIGRATE=true

# ===================== TEST SPECIFIC =====================
TEST_SHOW_SQL=false
TEST_FORMAT_SQL=false
TEST_HIBERNATE_DDL_AUTO=create-drop