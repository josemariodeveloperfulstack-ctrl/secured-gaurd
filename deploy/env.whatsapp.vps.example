# =============================================================================
# WHATSAPP — VPS / PRODUÇÃO (Linux)
# =============================================================================
# Como usar:
#   1. Copie para o diretório de deploy na VPS (ex.: /var/www/secured_guard/ci/.env)
#   2. Preencha todos os <PREENCHER>
#   3. bash deploy/configure-whatsapp-agent.sh .env docker-compose.ci.yml
#   4. docker compose -f docker-compose.ci.yml up -d evolution-api-ci backend-ci whatsapp-service-ci
#
# Documentação completa: docs/WHATSAPP_AGENTE_CONFIGURACAO.md
# =============================================================================

# --- Ordem de fallback (SaaS primeiro se tiver contrato) ---
WHATSAPP_PROVIDER_ORDER=uazapi,zapi,evolution,baileys

# --- Evolution API (principal na VPS) ---
EVOLUTION_API_ENABLED=true
EVOLUTION_API_URL=https://evolution.z7botsolutions.com.br
EVOLUTION_API_KEY=<PREENCHER>
EVOLUTION_API_INSTANCE=securedguard
EVOLUTION_SERVER_URL=https://evolution.z7botsolutions.com.br

# --- UAZAPI (https://docs.uazapi.com) ---
UAZAPI_ENABLED=false
UAZAPI_BASE_URL=<PREENCHER>
UAZAPI_INSTANCE_TOKEN=<PREENCHER>
UAZAPI_ADMIN_TOKEN=

# --- Z-API (https://developer.z-api.io) ---
ZAPI_ENABLED=false
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=<PREENCHER>
ZAPI_INSTANCE_TOKEN=<PREENCHER>
ZAPI_CLIENT_TOKEN=<PREENCHER>

# --- Baileys REST (fallback — URL interna Docker, NÃO use localhost) ---
BAILEYS_ENABLED=true
BAILEYS_REST_URL=http://whatsapp-service-ci:3333
BAILEYS_INSTANCE_KEY=securedguard_ci
BAILEYS_REST_TOKEN=

# --- Agente IA + memória em banco ---
GEMINI_API_ENABLED=true
GEMINI_API_KEY=<PREENCHER>
WHATSAPP_AGENT_AI_ENABLED=true
WHATSAPP_AGENT_AI_MODEL=gemini-1.5-flash
WHATSAPP_AGENT_CONTEXT_MAX_MESSAGES=40
WHATSAPP_WEBHOOK_REQUIRE_API_KEY=true

# --- URL pública da API (webhook Evolution — ajuste para seu domínio) ---
# Configure na Evolution: POST https://SEU_DOMINIO/api/webhooks/whatsapp/evolution
# Header: apikey = mesmo valor de EVOLUTION_API_KEY
# API_PUBLIC_URL=https://securedguard.z7botsolutions.com.br
