# =====================================================
# SECURED GUARD - FRONTEND CI (Integração Contínua)
# =====================================================
# Copie este arquivo para .env.ci

# API Base URL
VITE_API_URL=https://ci.z7botsolutions.com.br/api

# Environment
VITE_ENVIRONMENT=ci
VITE_APP_NAME=Secured Guard CI

# WebSocket URL
VITE_WS_URL=wss://ci.z7botsolutions.com.br/ws

# Debug
VITE_DEBUG=true

# Upload limits
VITE_MAX_FILE_SIZE=52428800

# Features flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_FACIAL_RECOGNITION=false

