# ============================================
# SECURED GUARD FRONTEND - PRODUÇÃO
# Multi-stage build com Nginx otimizado
# ============================================

# ============================================
# STAGE 1: Build
# ============================================
FROM node:20-alpine AS builder

WORKDIR /build

# Argumentos de build (variáveis de ambiente do Vite)
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_ENVIRONMENT

# Definir como variáveis de ambiente para o Vite usar durante o build
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}
ENV VITE_ENVIRONMENT=${VITE_ENVIRONMENT}

# Copiar package files
COPY package*.json ./

# npm no Docker/CI: ECONNRESET / "network aborted" — mais retries e menos sockets paralelos
ENV NPM_CONFIG_FETCH_RETRIES=8 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=30000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=180000 \
    NPM_CONFIG_MAXSOCKETS=1

# Até 4 tentativas com backoff (entre tentativas o registry costuma estabilizar)
RUN for attempt in 1 2 3 4; do \
      echo "npm ci (tentativa ${attempt}/4)..."; \
      npm ci && exit 0; \
      echo "⚠️ npm ci falhou (tentativa ${attempt})"; \
      [ "$attempt" -eq 4 ] && exit 1; \
      sleep $((attempt * 25)); \
    done

# Copiar código fonte
COPY . .

# Build para produção
RUN npm run build

# ============================================
# STAGE 2: Runtime com Nginx
# ============================================
FROM nginx:1.25-alpine AS production

# Metadados
LABEL maintainer="Secured Guard Team"
LABEL environment="production"
LABEL version="1.0.0"

# Instalar curl para health check
RUN apk add --no-cache curl

# Remover configuração padrão do Nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copiar configuração customizada do Nginx
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Copiar build do builder
COPY --from=builder /build/dist /usr/share/nginx/html

# Configurar permissões para usuário nginx
# (A imagem nginx:alpine já vem com usuário/grupo nginx criados)
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

USER nginx

# Expor porta
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Executar Nginx
CMD ["nginx", "-g", "daemon off;"]
