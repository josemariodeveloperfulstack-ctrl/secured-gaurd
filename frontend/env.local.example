# =====================================================
# SECURED GUARD - FRONTEND LOCAL (Desenvolvimento)
# =====================================================
# Copie este arquivo para .env.local e ajuste as configurações

# API Base URL - Para testar no celular na mesma rede:
# 1. Descubra o IP do seu PC: ipconfig (Windows) ou ifconfig (Linux/Mac)
# 2. Substitua 192.168.1.116 pelo IP do seu PC
# 3. Certifique-se que o backend está rodando e aceitando conexões externas
VITE_API_URL=http://192.168.1.116:8081/api

# WebSocket URL - Use o mesmo IP
VITE_WS_URL=ws://192.168.1.116:8081/ws

# Environment
VITE_ENVIRONMENT=local
VITE_APP_NAME=Secured Guard Local

# Debug
VITE_DEBUG=true

# Upload limits
VITE_MAX_FILE_SIZE=52428800

# Features flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_FACIAL_RECOGNITION=false

