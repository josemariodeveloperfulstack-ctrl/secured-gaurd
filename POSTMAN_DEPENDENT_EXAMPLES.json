    "4_buscar_por_cpf": {
      "method": "GET",
      "url": "http://localhost:8081/api/dependents/cpf/{cpf}",
      "description": "Busca dependentes por CPF"
    },
    "5_buscar_por_relacionamento": {
      "method": "GET",
      "url": "http://localhost:8081/api/dependents/relationship/{relationship}",
      "description": "Lista dependentes por tipo de relacionamento"
    },
    "6_criar_dependente": {
      "method": "POST",
      "url": "http://localhost:8081/api/dependents",
      "description": "Cria novo dependente"
    },
    "7_atualizar_dependente": {
      "method": "PUT",
      "url": "http://localhost:8081/api/dependents/{id}",
      "description": "Atualiza dependente existente"
    },
    "8_excluir_dependente": {
      "method": "DELETE",
      "url": "http://localhost:8081/api/dependents/{id}",
      "description": "Exclui dependente"
    }
