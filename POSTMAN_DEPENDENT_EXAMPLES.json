  "INSTRUCOES_POSTMAN": {
    "method": "POST",
    "url": "http://localhost:8081/api/dependents",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer SEU_TOKEN_JWT_AQUI"
    },
    "body": "Use um dos exemplos acima (EXEMPLO_MINIMO, EXEMPLO_COMPLETO, etc)",
    "observacoes": [
      "O campo 'employeeId' precisa de um UUID válido de um funcionário existente",
      "Para obter o employeeId: GET /api/employees",
      "Datas devem estar no formato yyyy-MM-dd (ex: 2024-01-15)",
      "CPF pode ser enviado com ou sem formatação",
      "Telefone pode ser enviado com ou sem formatação",
      "CEP pode ser enviado com ou sem formatação"
    ]
  },

  "ENDPOINTS_DISPONIVEIS": {
    "1_listar_todos": {
      "method": "GET",
