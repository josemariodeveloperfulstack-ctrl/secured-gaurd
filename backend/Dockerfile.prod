# ========================================
# STAGE 1: Build
# ========================================
FROM maven:3.9.9-amazoncorretto-17 AS builder

WORKDIR /app

# Copiar pom.xml e baixar dependências (cache layer)
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copiar código fonte
COPY src ./src

# Build do projeto
RUN mvn clean package -DskipTests -B

# ========================================
# STAGE 2: Runtime
# ========================================
FROM amazoncorretto:17-alpine

LABEL maintainer="Z7 Design <contato@z7design.com>"
LABEL description="Secured Guard Backend - Production"
LABEL version="1.0.0"

# Instalar dependências necessárias
RUN apk add --no-cache \
    curl \
    fontconfig \
    ttf-dejavu \
    && rm -rf /var/cache/apk/*

# Criar usuário não-root
RUN addgroup -S spring && adduser -S spring -G spring

# Criar diretórios necessários
RUN mkdir -p /app/logs /app/uploads /app/temp && \
    chown -R spring:spring /app

WORKDIR /app

# Copiar JAR do stage de build
COPY --from=builder /app/target/*.jar app.jar

# Mudar ownership
RUN chown spring:spring app.jar

# Usar usuário não-root
USER spring:spring

# Variáveis de ambiente padrão
ENV SPRING_PROFILES_ACTIVE=prod \
    JAVA_OPTS="-Xms512m -Xmx2048m -XX:+UseG1GC -XX:MaxGCPauseMillis=200" \
    TZ=America/Sao_Paulo

# Expor porta
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# Comando de inicialização
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

