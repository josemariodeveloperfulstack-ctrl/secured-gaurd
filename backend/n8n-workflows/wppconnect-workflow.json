{
  "name": "WhatsApp WPPConnect - SecuredGuard",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wppconnect",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-wppconnect",
      "name": "Webhook WPPConnect",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "wppconnect-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.action }}",
              "operation": "equals",
              "value2": "checkConnection"
            }
          ]
        }
      },
      "id": "check-connection",
      "name": "Check Connection",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8080/api/status",
        "options": {}
      },
      "id": "wppconnect-status",
      "name": "WPPConnect Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8080/api/send-message",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "sessionName",
              "value": "={{ $json.sessionName }}"
            },
            {
              "name": "number",
              "value": "={{ $json.phoneNumber }}"
            },
            {
              "name": "text",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "wppconnect-send",
      "name": "WPPConnect Send Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8080/api/send-file",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "sessionName",
              "value": "={{ $json.sessionName }}"
            },
            {
              "name": "number",
              "value": "={{ $json.phoneNumber }}"
            },
            {
              "name": "path",
              "value": "={{ $json.pdfPath }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "wppconnect-send-file",
      "name": "WPPConnect Send File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.pdfPath }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "has-pdf",
      "name": "Has PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"provider\": \"wppconnect\", \"message\": \"Mensagem enviada com sucesso\" }"
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"provider\": \"wppconnect\", \"status\": \"connected\" }"
      },
      "id": "status-response",
      "name": "Status Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 200]
    }
  ],
  "connections": {
    "Webhook WPPConnect": {
      "main": [
        [
          {
            "node": "Check Connection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Connection": {
      "main": [
        [
          {
            "node": "WPPConnect Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "WPPConnect Send Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WPPConnect Send Message": {
      "main": [
        [
          {
            "node": "Has PDF?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has PDF?": {
      "main": [
        [
          {
            "node": "WPPConnect Send File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WPPConnect Send File": {
      "main": [
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WPPConnect Status": {
      "main": [
        [
          {
            "node": "Status Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "1"
} 