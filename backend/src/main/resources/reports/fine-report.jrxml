<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="fine-report" 
              pageWidth="595" 
              pageHeight="842" 
              columnWidth="555" 
              leftMargin="20" 
              rightMargin="20" 
              topMargin="20" 
              bottomMargin="20">
    
    <!-- Parâmetros -->
    <parameter name="GENERATION_DATE" class="java.lang.String"/>
    <parameter name="TOTAL_FINES" class="java.lang.Integer"/>
    <parameter name="PERIOD" class="java.lang.String"/>
    <parameter name="VEHICLE_FILTER" class="java.lang.String"/>
    <parameter name="DRIVER_FILTER" class="java.lang.String"/>
    <parameter name="STATUS_FILTER" class="java.lang.String"/>
    <parameter name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="PENDING_FINES" class="java.lang.Integer"/>
    <parameter name="PAID_FINES" class="java.lang.Integer"/>
    <parameter name="OVERDUE_FINES" class="java.lang.Integer"/>
    
    <!-- Campos -->
    <field name="id" class="java.util.UUID"/>
    <field name="vehiclePlate" class="java.lang.String"/>
    <field name="vehicleBrand" class="java.lang.String"/>
    <field name="vehicleModel" class="java.lang.String"/>
    <field name="driverName" class="java.lang.String"/>
    <field name="driverLicenseNumber" class="java.lang.String"/>
    <field name="infractionDate" class="java.time.LocalDate"/>
    <field name="dueDate" class="java.time.LocalDate"/>
    <field name="description" class="java.lang.String"/>
    <field name="location" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>
    <field name="statusDescription" class="java.lang.String"/>
    <field name="paymentDate" class="java.time.LocalDate"/>
    <field name="notes" class="java.lang.String"/>
    <field name="createdAt" class="java.time.LocalDate"/>
    <field name="updatedAt" class="java.time.LocalDate"/>
    
    <!-- Título -->
    <title>
        <band height="100">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[RELATÓRIO DE MULTAS]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="35" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Período: $P{PERIOD}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="50" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Veículo: $P{VEHICLE_FILTER} | Motorista: $P{DRIVER_FILTER} | Status: $P{STATUS_FILTER}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="65" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Gerado em: $P{GENERATION_DATE}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="80" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Total de Multas: $P{TOTAL_FINES} | Valor Total: R$ $P{TOTAL_AMOUNT}]]></text>
            </staticText>
        </band>
    </title>
    
    <!-- Cabeçalho da página -->
    <pageHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="10" width="50" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Data Infração]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="50" y="10" width="50" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Vencimento]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="100" y="10" width="70" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Veículo]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="170" y="10" width="80" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Motorista]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="250" y="10" width="60" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Valor]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="310" y="10" width="50" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="360" y="10" width="100" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Local]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="460" y="10" width="95" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Descrição]]></text>
            </staticText>
        </band>
    </pageHeader>
    
    <!-- Detalhes -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{infractionDate}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="50" y="0" width="50" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dueDate}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="100" y="0" width="70" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{vehiclePlate} + " - " + $F{vehicleBrand}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="170" y="0" width="80" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{driverName} != null ? $F{driverName} : "Não informado"]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="250" y="0" width="60" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["R$ " + $F{amount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="310" y="0" width="50" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="360" y="0" width="100" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{location}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="460" y="0" width="95" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <!-- Rodapé da página -->
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="0" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    
    <!-- Resumo -->
    <summary>
        <band height="120">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[RESUMO EXECUTIVO]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="25" width="185" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Total de Multas:]]></text>
            </staticText>
            <textField>
                <reportElement x="185" y="25" width="50" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_FINES}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="40" width="185" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Valor Total:]]></text>
            </staticText>
            <textField>
                <reportElement x="185" y="40" width="100" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["R$ " + $P{TOTAL_AMOUNT}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="55" width="185" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Multas Pendentes:]]></text>
            </staticText>
            <textField>
                <reportElement x="185" y="55" width="50" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PENDING_FINES}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="70" width="185" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Multas Pagas:]]></text>
            </staticText>
            <textField>
                <reportElement x="185" y="70" width="50" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PAID_FINES}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="85" width="185" height="15"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Multas Vencidas:]]></text>
            </staticText>
            <textField>
                <reportElement x="185" y="85" width="50" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{OVERDUE_FINES}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="100" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Relatório gerado automaticamente pelo sistema Secure Guard]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>