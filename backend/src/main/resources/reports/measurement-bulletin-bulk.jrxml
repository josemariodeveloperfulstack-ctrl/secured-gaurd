<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="measurement-bulletin-bulk" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b2c3d4e5-f6g7-8901-bcde-f23456789012">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
    
    <!-- Parâmetros -->
    <parameter name="TOTAL_BULLETINS" class="java.lang.Integer"/>
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="COMPANY_NAME" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS_LEFT" class="java.lang.String"/>
    <parameter name="COMPANY_PHONE_LEFT" class="java.lang.String"/>
    <parameter name="COMPANY_EMAIL_LEFT" class="java.lang.String"/>
    <parameter name="COMPANY_ADDRESS_RIGHT" class="java.lang.String"/>
    <parameter name="COMPANY_PHONE_RIGHT" class="java.lang.String"/>
    <parameter name="COMPANY_EMAIL_RIGHT" class="java.lang.String"/>
    <parameter name="COMPANY_WEBSITE" class="java.lang.String"/>
    <parameter name="GENERATED_DATE" class="java.lang.String"/>
    
    <!-- Campos do datasource -->
    <field name="id" class="java.util.UUID"/>
    <field name="companyName" class="java.lang.String"/>
    <field name="periodStart" class="java.time.LocalDate"/>
    <field name="periodEnd" class="java.time.LocalDate"/>
    <field name="contractNumber" class="java.lang.String"/>
    <field name="subtotal" class="java.math.BigDecimal"/>
    <field name="elaboratedBy" class="java.lang.String"/>
    <field name="measuredBy" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    
    <!-- Cabeçalho da empresa -->
    <title>
        <band height="80" splitType="Stretch">
            <!-- Logo e nome da empresa -->
            <frame>
                <reportElement x="0" y="0" width="555" height="40" uuid="header-frame"/>
                <box>
                    <pen lineWidth="0"/>
                </box>
                
                <!-- Área preta com logo -->
                <rectangle>
                    <reportElement x="0" y="0" width="200" height="40" backcolor="#000000" uuid="logo-bg"/>
                </rectangle>
                
                <!-- Logo "P" -->
                <staticText>
                    <reportElement x="10" y="10" width="20" height="20" uuid="logo-p"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="Arial" size="16" isBold="true" pdfFontName="Helvetica-Bold"/>
                    </textElement>
                    <text><![CDATA[P]]></text>
                </staticText>
                
                <!-- Nome da empresa -->
                <staticText>
                    <reportElement x="35" y="5" width="120" height="15" uuid="company-name"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="Arial" size="14" isBold="true" pdfFontName="Helvetica-Bold"/>
                    </textElement>
                    <text><![CDATA[Promover]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="35" y="20" width="120" height="15" uuid="company-subtitle"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[Vigilância & Serviços]]></text>
                </staticText>
                
                <!-- Área laranja -->
                <rectangle>
                    <reportElement x="200" y="0" width="355" height="40" backcolor="#FF8C00" uuid="gradient-bg"/>
                </rectangle>
            </frame>
            
            <!-- Espaçamento -->
            <staticText>
                <reportElement x="0" y="45" width="555" height="20" uuid="spacing"/>
                <text><![CDATA[ ]]></text>
            </staticText>
        </band>
    </title>
    
    <!-- Cabeçalho da página -->
    <pageHeader>
        <band height="50" splitType="Stretch">
            <!-- Título -->
            <textField>
                <reportElement x="0" y="0" width="555" height="30" uuid="title"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="18" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            
            <!-- Informações do lote -->
            <staticText>
                <reportElement x="0" y="30" width="200" height="15" uuid="total-bulletins-label"/>
                <textElement>
                    <font fontName="Arial" size="12" pdfFontName="Helvetica"/>
                </textElement>
                <text><![CDATA[Total de Boletins:]]></text>
            </staticText>
            
            <textField>
                <reportElement x="100" y="30" width="50" height="15" uuid="total-bulletins-value"/>
                <textElement>
                    <font fontName="Arial" size="12" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_BULLETINS}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="200" y="30" width="150" height="15" uuid="total-amount-label"/>
                <textElement>
                    <font fontName="Arial" size="12" pdfFontName="Helvetica"/>
                </textElement>
                <text><![CDATA[Valor Total:]]></text>
            </staticText>
            
            <textField pattern="R$ #,##0.00">
                <reportElement x="280" y="30" width="100" height="15" uuid="total-amount-value"/>
                <textElement>
                    <font fontName="Arial" size="12" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_AMOUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    
    <!-- Cabeçalho da coluna -->
    <columnHeader>
        <band height="30" splitType="Stretch">
            <!-- Cabeçalho da tabela -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#DC2626" uuid="table-header-bg"/>
            </rectangle>
            
            <staticText>
                <reportElement x="5" y="5" width="60" height="15" uuid="contract-header"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Contrato]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="70" y="5" width="120" height="15" uuid="company-header"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Empresa]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="195" y="5" width="100" height="15" uuid="period-header"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Período]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="300" y="5" width="80" height="15" uuid="status-header"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="385" y="5" width="80" height="15" uuid="subtotal-header"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="470" y="5" width="80" height="15" uuid="elaborated-header"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Elaborado]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <!-- Detalhes -->
    <detail>
        <band height="25" splitType="Stretch">
            <!-- Dados do boletim -->
            <textField>
                <reportElement x="5" y="2" width="60" height="15" uuid="contract-value"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="9" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{contractNumber}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="70" y="2" width="120" height="15" uuid="company-value"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Arial" size="9" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{companyName}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="195" y="2" width="100" height="15" uuid="period-value"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="9" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[($F{periodStart} != null ? $F{periodStart}.toString() : "") + " a " + ($F{periodEnd} != null ? $F{periodEnd}.toString() : "")]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="300" y="2" width="80" height="15" uuid="status-value"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="9" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            
            <textField pattern="R$ #,##0.00">
                <reportElement x="385" y="2" width="80" height="15" uuid="subtotal-value"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="9" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="470" y="2" width="80" height="15" uuid="elaborated-value"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="9" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{elaboratedBy}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <!-- Rodapé da página -->
    <pageFooter>
        <band height="120" splitType="Stretch">
            <!-- Barra gradiente do rodapé -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="20" backcolor="#FF8C00" uuid="footer-gradient"/>
            </rectangle>
            
            <!-- Informações de contato -->
            <frame>
                <reportElement x="0" y="25" width="555" height="80" uuid="footer-frame"/>
                
                <!-- Coluna esquerda -->
                <staticText>
                    <reportElement x="0" y="0" width="180" height="12" uuid="footer-left-title"/>
                    <textElement>
                        <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                    </textElement>
                    <text><![CDATA[Promover Vigilância Patrimonial Ltda]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="0" y="15" width="180" height="10" uuid="footer-left-address"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[📍 R. Coronel João Camargos, n° 267 - Centro - Contagem/MG]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="0" y="25" width="180" height="10" uuid="footer-left-phone"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[📞 (31) 2559-1245]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="0" y="35" width="180" height="10" uuid="footer-left-email"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[✉️ comercial@promovervigilancia.com.br]]></text>
                </staticText>
                
                <!-- Coluna central -->
                <staticText>
                    <reportElement x="200" y="0" width="155" height="10" uuid="footer-center-website"/>
                    <textElement textAlignment="Center">
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[🌐 www.promovervigilancia.com.br]]></text>
                </staticText>
                
                <!-- Coluna direita -->
                <staticText>
                    <reportElement x="375" y="0" width="180" height="12" uuid="footer-right-title"/>
                    <textElement>
                        <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                    </textElement>
                    <text><![CDATA[Promover Terceirização e Serviços]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="375" y="15" width="180" height="10" uuid="footer-right-address"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[📍 Rua Pelegrino de Paula Ferreira, n° 77 - Centro - Contagem/MG]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="375" y="25" width="180" height="10" uuid="footer-right-phone"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[📞 (31) 2559-6834]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="375" y="35" width="180" height="10" uuid="footer-right-email"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[✉️ comercial@promovervigilancia.com.br]]></text>
                </staticText>
            </frame>
        </band>
    </pageFooter>
</jasperReport>
