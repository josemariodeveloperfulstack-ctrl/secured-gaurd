                    </textElement>
                    <text><![CDATA[✉️ comercial@promovervigilancia.com.br]]></text>
                </staticText>
                
                <!-- Coluna central -->
                <staticText>
                    <reportElement x="200" y="0" width="155" height="10" uuid="footer-center-website"/>
                    <textElement textAlignment="Center">
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[🌐 www.promovervigilancia.com.br]]></text>
                </staticText>
                
                <!-- Coluna direita -->
                <staticText>
                    <reportElement x="375" y="0" width="180" height="12" uuid="footer-right-title"/>
                    <textElement>
                        <font fontName="Arial" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                    </textElement>
                    <text><![CDATA[Promover Terceirização e Serviços]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="375" y="15" width="180" height="10" uuid="footer-right-address"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[📍 Rua Pelegrino de Paula Ferreira, n° 77 - Centro - Contagem/MG]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="375" y="25" width="180" height="10" uuid="footer-right-phone"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[📞 (31) 2559-6834]]></text>
                </staticText>
                
                <staticText>
                    <reportElement x="375" y="35" width="180" height="10" uuid="footer-right-email"/>
                    <textElement>
                        <font fontName="Arial" size="8" pdfFontName="Helvetica"/>
                    </textElement>
                    <text><![CDATA[✉️ comercial@promovervigilancia.com.br]]></text>
                </staticText>
            </frame>
        </band>
    </pageFooter>
</jasperReport>
