<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="vehicle-report" 
              pageWidth="595" 
              pageHeight="842" 
              columnWidth="555" 
              leftMargin="20" 
              rightMargin="20" 
              topMargin="20" 
              bottomMargin="20" 
              uuid="b2c3d4e5-f678-8901-bcde-f23456789012">
    
    <!-- Parâmetros -->
    <parameter name="GENERATION_DATE" class="java.lang.String"/>
    <parameter name="TOTAL_VEHICLES" class="java.lang.Integer"/>
    <parameter name="ACTIVE_VEHICLES" class="java.lang.Integer"/>
    <parameter name="MAINTENANCE_VEHICLES" class="java.lang.Integer"/>
    <parameter name="INACTIVE_VEHICLES" class="java.lang.Integer"/>
    <parameter name="FILTER_STATUS" class="java.lang.String"/>
    
    <!-- Campos -->
    <field name="plate" class="java.lang.String"/>
    <field name="brand" class="java.lang.String"/>
    <field name="model" class="java.lang.String"/>
    <field name="year" class="java.lang.Integer"/>
    <field name="fuelType" class="java.lang.String"/>
    <field name="currentMileage" class="java.lang.Integer"/>
    <field name="capacity" class="java.lang.Integer"/>
    <field name="status" class="java.lang.String"/>
    <field name="createdAt" class="java.time.LocalDateTime"/>
    <field name="updatedAt" class="java.time.LocalDateTime"/>
    
    <!-- Estilos -->
    <style name="titleStyle" fontName="DejaVu Sans" fontSize="20" isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="subtitleStyle" fontName="DejaVu Sans" fontSize="14" isBold="true" pdfFontName="Helvetica-Bold"/>
    <style name="headerStyle" fontName="DejaVu Sans" fontSize="10" isBold="true" pdfFontName="Helvetica-Bold" 
            backcolor="#FFD700" forecolor="#000000"/>
    <style name="dataStyle" fontName="DejaVu Sans" fontSize="9" pdfFontName="Helvetica"/>
    <style name="statusActiveStyle" fontName="DejaVu Sans" fontSize="8" pdfFontName="Helvetica" 
            forecolor="#00FF00"/>
    <style name="statusMaintenanceStyle" fontName="DejaVu Sans" fontSize="8" pdfFontName="Helvetica" 
            forecolor="#FFA500"/>
    <style name="statusInactiveStyle" fontName="DejaVu Sans" fontSize="8" pdfFontName="Helvetica" 
            forecolor="#FF0000"/>
    
    <!-- Cabeçalho da página -->
    <pageHeader>
        <band height="140" splitType="Stretch">
            <!-- Logo da empresa -->
            <staticText>
                <reportElement x="0" y="0" width="100" height="30" uuid="logo-box"/>
                <box>
                    <pen lineWidth="2" lineColor="#FFD700"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="24" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[P]]></text>
            </staticText>
            
            <!-- Nome da empresa -->
            <staticText>
                <reportElement x="120" y="0" width="200" height="20" uuid="company-name"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="16" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[PROMOVER]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="120" y="20" width="200" height="15" uuid="company-subtitle"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="12" pdfFontName="Helvetica"/>
                </textElement>
                <text><![CDATA[Vigilância Patrimonial - LTDA]]></text>
            </staticText>
            
            <!-- Título do relatório -->
            <staticText>
                <reportElement x="0" y="50" width="555" height="25" uuid="report-title"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="16" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[RELATÓRIO DE VEÍCULOS DA FROTA]]></text>
            </staticText>
            
            <!-- Informações do relatório -->
            <staticText>
                <reportElement x="0" y="80" width="100" height="15" uuid="date-label"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Data de Geração:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="80" width="150" height="15" uuid="date-value"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{GENERATION_DATE}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="280" y="80" width="100" height="15" uuid="filter-label"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Filtro:]]></text>
            </staticText>
            <textField>
                <reportElement x="380" y="80" width="175" height="15" uuid="filter-value"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{FILTER_STATUS}]]></textFieldExpression>
            </textField>
            
            <!-- Resumo estatístico -->
            <staticText>
                <reportElement x="0" y="100" width="100" height="15" uuid="total-label"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Total de Veículos:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="100" width="50" height="15" uuid="total-value"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_VEHICLES}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="180" y="100" width="100" height="15" uuid="active-label"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Ativos:]]></text>
            </staticText>
            <textField>
                <reportElement x="280" y="100" width="50" height="15" uuid="active-value"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ACTIVE_VEHICLES}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="350" y="100" width="100" height="15" uuid="maintenance-label"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Em Manutenção:]]></text>
            </staticText>
            <textField>
                <reportElement x="450" y="100" width="50" height="15" uuid="maintenance-value"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{MAINTENANCE_VEHICLES}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="0" y="120" width="100" height="15" uuid="inactive-label"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Inativos:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="120" width="50" height="15" uuid="inactive-value"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="10" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{INACTIVE_VEHICLES}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    
    <!-- Cabeçalho das colunas -->
    <columnHeader>
        <band height="25" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="60" height="25" uuid="col-plate"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Placa]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="60" y="0" width="100" height="25" uuid="col-brand-model"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Marca/Modelo]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="160" y="0" width="40" height="25" uuid="col-year"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Ano]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="200" y="0" width="80" height="25" uuid="col-fuel"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Combustível]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="280" y="0" width="80" height="25" uuid="col-mileage"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Quilometragem]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="360" y="0" width="60" height="25" uuid="col-capacity"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Capacidade]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="420" y="0" width="80" height="25" uuid="col-status"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="500" y="0" width="55" height="25" uuid="col-created"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[Cadastrado]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <!-- Detalhes -->
    <detail>
        <band height="20" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="60" height="20" uuid="data-plate"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{plate}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="60" y="0" width="100" height="20" uuid="data-brand-model"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{brand} + " " + $F{model}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="160" y="0" width="40" height="20" uuid="data-year"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{year}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="200" y="0" width="80" height="20" uuid="data-fuel"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fuelType}]]></textFieldExpression>
            </textField>
            
            <textField pattern="#,##0.000">
                <reportElement x="280" y="0" width="80" height="20" uuid="data-mileage"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{currentMileage} != null ? $F{currentMileage} / 1000.0 : 0]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="360" y="0" width="60" height="20" uuid="data-capacity"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{capacity} != null ? $F{capacity} + " pessoas" : "N/A"]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="420" y="0" width="80" height="20" uuid="data-status"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            
            <textField pattern="dd/MM/yyyy">
                <reportElement x="500" y="0" width="55" height="20" uuid="data-created"/>
                <box>
                    <pen lineWidth="1"/>
                    <topPen lineWidth="1"/>
                    <leftPen lineWidth="1"/>
                    <bottomPen lineWidth="1"/>
                    <rightPen lineWidth="1"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{createdAt}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <!-- Rodapé da página -->
    <pageFooter>
        <band height="30" splitType="Stretch">
            <textField>
                <reportElement x="0" y="10" width="200" height="15" uuid="footer-info"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA["Relatório gerado pelo Sistema Secured Guard"]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="355" y="10" width="200" height="15" uuid="footer-page"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="8" pdfFontName="Helvetica"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    
</jasperReport>
