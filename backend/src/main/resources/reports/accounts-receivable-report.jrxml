                <text><![CDATA[Método]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="20" splitType="Stretch">
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="60" height="20" uuid="client-name"/>
