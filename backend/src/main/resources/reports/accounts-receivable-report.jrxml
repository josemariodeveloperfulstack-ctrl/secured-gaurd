    <field name="paymentMethodDescription" class="java.lang.String"/>
    <field name="isOverdue" class="java.lang.String"/>
    <field name="daysUntilDue" class="java.lang.String"/>
    
    <title>
        <band height="79" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30" uuid="title-text"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[RELATÓRIO DE CONTAS A RECEBER]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="555" height="20" uuid="generation-date"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Gerado em: " + $P{GENERATION_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="50" width="555" height="20" uuid="period"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Período: " + $P{PERIOD}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <pageHeader>
        <band height="60" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="200" height="15" uuid="client-filter"/>
