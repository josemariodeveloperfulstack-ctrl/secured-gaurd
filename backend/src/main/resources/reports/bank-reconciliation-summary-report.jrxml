<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreports.xsd" 
              name="bank-reconciliation-summary-report" 
              pageWidth="595" 
              pageHeight="842" 
              columnWidth="555" 
              leftMargin="20" 
              rightMargin="20" 
              topMargin="20" 
              bottomMargin="20">
    
    <!-- Parâmetros -->
    <parameter name="GENERATION_DATE" class="java.lang.String"/>
    <parameter name="PERIOD" class="java.lang.String"/>
    <parameter name="BANK_FILTER" class="java.lang.String"/>
    <parameter name="TOTAL_TRANSACTIONS" class="java.lang.Integer"/>
    <parameter name="MATCHED_TRANSACTIONS" class="java.lang.Integer"/>
    <parameter name="UNMATCHED_TRANSACTIONS" class="java.lang.Integer"/>
    <parameter name="PENDING_TRANSACTIONS" class="java.lang.Integer"/>
    <parameter name="BANK_STATS" class="java.util.Map"/>
    
    <!-- Campos -->
    <field name="id" class="java.util.UUID"/>
    <field name="fileName" class="java.lang.String"/>
    <field name="bankName" class="java.lang.String"/>
    <field name="accountNumber" class="java.lang.String"/>
    <field name="period" class="java.lang.String"/>
    <field name="transactionDate" class="java.time.LocalDate"/>
    <field name="description" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="balance" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>
    <field name="referenceNumber" class="java.lang.String"/>
    <field name="category" class="java.lang.String"/>
    <field name="notes" class="java.lang.String"/>
    <field name="systemTransactionType" class="java.lang.String"/>
    <field name="reconciliationDate" class="java.time.LocalDate"/>
    <field name="reconciliationUser" class="java.lang.String"/>
    
    <!-- Título -->
    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[RELATÓRIO DE RESUMO - CONCILIAÇÃO BANCÁRIA]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="35" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Período: $P{PERIOD}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="50" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Banco: $P{BANK_FILTER}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="65" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Gerado em: $P{GENERATION_DATE}]]></text>
            </staticText>
        </band>
    </title>
    
    <!-- Cabeçalho da página -->
    <pageHeader>
        <band height="100">
            <!-- Estatísticas Gerais -->
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[ESTATÍSTICAS GERAIS]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="25" width="180" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Total de Transações: $P{TOTAL_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="180" y="25" width="120" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Conciliadas: $P{MATCHED_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="300" y="25" width="120" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Não Conciliadas: $P{UNMATCHED_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="420" y="25" width="135" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Pendentes: $P{PENDING_TRANSACTIONS}]]></text>
            </staticText>
            
            <!-- Percentuais -->
            <staticText>
                <reportElement x="0" y="50" width="180" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Taxa de Conciliação: " + ($P{TOTAL_TRANSACTIONS} > 0 ? 
                    String.format("%.1f", ($P{MATCHED_TRANSACTIONS}.doubleValue() / $P{TOTAL_TRANSACTIONS}.doubleValue()) * 100) : "0.0") + "%"]]></textFieldExpression>
            </staticText>
            
            <staticText>
                <reportElement x="180" y="50" width="180" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Taxa de Não Conciliação: " + ($P{TOTAL_TRANSACTIONS} > 0 ? 
                    String.format("%.1f", ($P{UNMATCHED_TRANSACTIONS}.doubleValue() / $P{TOTAL_TRANSACTIONS}.doubleValue()) * 100) : "0.0") + "%"]]></textFieldExpression>
            </staticText>
            
            <staticText>
                <reportElement x="360" y="50" width="195" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Taxa de Pendência: " + ($P{TOTAL_TRANSACTIONS} > 0 ? 
                    String.format("%.1f", ($P{PENDING_TRANSACTIONS}.doubleValue() / $P{TOTAL_TRANSACTIONS}.doubleValue()) * 100) : "0.0") + "%"]]></textFieldExpression>
            </staticText>
            
            <!-- Cabeçalho da tabela -->
            <staticText>
                <reportElement x="0" y="80" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[DETALHAMENTO POR BANCO]]></text>
            </staticText>
        </band>
    </pageHeader>
    
    <!-- Detalhes -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="150" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{bankName}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="150" y="0" width="100" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{accountNumber}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="250" y="0" width="80" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{transactionDate}]]></textFieldExpression>
            </textField>
            
            <textField isStretchWithOverflow="true">
                <reportElement x="330" y="0" width="150" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="480" y="0" width="75" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <!-- Rodapé da página -->
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="0" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    
    <!-- Resumo -->
    <summary>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[RESUMO EXECUTIVO]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="25" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Este relatório apresenta um resumo consolidado das operações de conciliação bancária]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="40" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[para o período especificado, incluindo estatísticas de conciliação por banco e status.]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="55" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Relatório gerado automaticamente pelo sistema Secure Guard]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
