<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreports.xsd" 
              name="bank-reconciliation-report" 
              pageWidth="595" 
              pageHeight="842" 
              columnWidth="555" 
              leftMargin="20" 
              rightMargin="20" 
              topMargin="20" 
              bottomMargin="20">
    
    <!-- Parâmetros -->
    <parameter name="GENERATION_DATE" class="java.lang.String"/>
    <parameter name="TOTAL_TRANSACTIONS" class="java.lang.Integer"/>
    <parameter name="FILE_NAME" class="java.lang.String"/>
    <parameter name="BANK_NAME" class="java.lang.String"/>
    <parameter name="ACCOUNT_NUMBER" class="java.lang.String"/>
    <parameter name="PERIOD" class="java.lang.String"/>
    <parameter name="MATCHED_TRANSACTIONS" class="java.lang.Integer"/>
    <parameter name="UNMATCHED_TRANSACTIONS" class="java.lang.Integer"/>
    <parameter name="PENDING_TRANSACTIONS" class="java.lang.Integer"/>
    <parameter name="FILTER_STATUS" class="java.lang.String"/>
    
    <!-- Campos -->
    <field name="id" class="java.util.UUID"/>
    <field name="fileName" class="java.lang.String"/>
    <field name="bankName" class="java.lang.String"/>
    <field name="accountNumber" class="java.lang.String"/>
    <field name="period" class="java.lang.String"/>
    <field name="transactionDate" class="java.time.LocalDate"/>
    <field name="description" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="balance" class="java.math.BigDecimal"/>
    <field name="status" class="java.lang.String"/>
    <field name="referenceNumber" class="java.lang.String"/>
    <field name="category" class="java.lang.String"/>
    <field name="notes" class="java.lang.String"/>
    <field name="systemTransactionType" class="java.lang.String"/>
    <field name="reconciliationDate" class="java.time.LocalDate"/>
    <field name="reconciliationUser" class="java.lang.String"/>
    
    <!-- Título -->
    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[RELATÓRIO DE CONCILIAÇÃO BANCÁRIA]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="35" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Arquivo: $P{FILE_NAME}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="50" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Banco: $P{BANK_NAME} - Conta: $P{ACCOUNT_NUMBER} - Período: $P{PERIOD}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="65" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Gerado em: $P{GENERATION_DATE}]]></text>
            </staticText>
        </band>
    </title>
    
    <!-- Cabeçalho da página -->
    <pageHeader>
        <band height="60">
            <!-- Estatísticas -->
            <staticText>
                <reportElement x="0" y="0" width="180" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Total de Transações: $P{TOTAL_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="180" y="0" width="120" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Conciliadas: $P{MATCHED_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="300" y="0" width="120" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Não Conciliadas: $P{UNMATCHED_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="420" y="0" width="135" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Pendentes: $P{PENDING_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="25" width="555" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Filtro aplicado: $P{FILTER_STATUS}]]></text>
            </staticText>
            
            <!-- Cabeçalho da tabela -->
            <staticText>
                <reportElement x="0" y="45" width="60" height="15"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Data]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="60" y="45" width="200" height="15"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Descrição]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="260" y="45" width="80" height="15"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Valor]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="340" y="45" width="80" height="15"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Saldo]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="420" y="45" width="60" height="15"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="480" y="45" width="75" height="15"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Referência]]></text>
            </staticText>
        </band>
    </pageHeader>
    
    <!-- Detalhes -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="60" height="15"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{transactionDate}]]></textFieldExpression>
            </textField>
            
            <textField isStretchWithOverflow="true">
                <reportElement x="60" y="0" width="200" height="15"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="260" y="0" width="80" height="15"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="340" y="0" width="80" height="15"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{balance}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="420" y="0" width="60" height="15"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="480" y="0" width="75" height="15"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{referenceNumber}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <!-- Rodapé da página -->
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="0" width="555" height="15"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    
    <!-- Resumo -->
    <summary>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[RESUMO DA CONCILIAÇÃO]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="25" width="180" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Total de Transações: $P{TOTAL_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="180" y="25" width="120" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Conciliadas: $P{MATCHED_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="300" y="25" width="120" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Não Conciliadas: $P{UNMATCHED_TRANSACTIONS}]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="420" y="25" width="135" height="15"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Pendentes: $P{PENDING_TRANSACTIONS}]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
