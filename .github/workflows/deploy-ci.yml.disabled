name: Deploy CI

on:
  push:
    branches: [ ci ]
  workflow_dispatch:

env:
  VPS_HOST: ${{ secrets.VPS_HOST }}
  VPS_USER: ${{ secrets.VPS_USER }}
  VPS_PORT: ${{ secrets.VPS_PORT || '22' }}

jobs:
  deploy:
    name: Deploy to CI Environment
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Setup SSH and sshpass
      run: |
        echo "🔧 Configurando SSH e sshpass..."
        
        # Install sshpass for password authentication
        sudo apt-get update -y
        sudo apt-get install -y sshpass dos2unix
        
        # Ensure SSH directory and known_hosts exist
        mkdir -p ~/.ssh
        chmod 700 ~/.ssh
        touch ~/.ssh/known_hosts
        chmod 600 ~/.ssh/known_hosts
        
        # Add VPS host key to known_hosts
        ssh-keyscan -p ${{ env.VPS_PORT }} ${{ env.VPS_HOST }} >> ~/.ssh/known_hosts
        
        echo "✅ SSH e sshpass configurados com sucesso!"
        
    - name: Deploy to VPS
      env:
        VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
      run: |
        echo "🚀 Iniciando deploy para VPS..."
        
        # Convert line endings and make scripts executable
        dos2unix deploy/deploy-to-vps-sshpass.sh deploy/deploy-to-vps.sh
        chmod +x deploy/deploy-to-vps-sshpass.sh deploy/deploy-to-vps.sh
        
        # Set environment variables for the script
        export VPS_HOST="${{ env.VPS_HOST }}"
        export VPS_USER="${{ env.VPS_USER }}"
        export VPS_PORT="${{ env.VPS_PORT }}"
        export VPS_PASSWORD="${{ secrets.VPS_PASSWORD }}"
        
        # Run deployment with password authentication
        ./deploy/deploy-to-vps-sshpass.sh
        
        echo "✅ Deploy concluído com sucesso!"
        
    - name: Verify Deployment
      env:
        VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
      run: |
        echo "🔍 Verificando deployment..."
        
        # Test if services are running using sshpass
        sshpass -p "${{ secrets.VPS_PASSWORD }}" ssh -p ${{ env.VPS_PORT }} -o StrictHostKeyChecking=no ${{ env.VPS_USER }}@${{ env.VPS_HOST }} \
          "cd /opt/secured-guard && docker compose -f deploy/docker-compose.prod.yml ps"
        
        echo "✅ Verificação concluída!"