name: Deploy PROD Environment

on:
  push:
    branches: [ main, master, production ]
    paths:
      - 'backend/**'
      - 'frontend/**'
      - 'deploy/docker-compose.prod-domains.yml'
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy'
        required: true
        default: 'prod'
        type: choice
        options:
        - prod
      confirm_deploy:
        description: 'Type "DEPLOY" to confirm production deployment'
        required: true
        type: string

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Validate deployment confirmation
      if: github.event_name == 'workflow_dispatch'
      run: |
        if [ "${{ github.event.inputs.confirm_deploy }}" != "DEPLOY" ]; then
          echo "❌ Deployment not confirmed. Please type 'DEPLOY' to confirm."
          exit 1
        fi
        
    - name: Deploy to PROD Environment
      run: |
        # Configurações
        VPS_HOST="${{ secrets.VPS_HOST }}"
        VPS_USER="${{ secrets.VPS_USER }}"
        VPS_PORT="${{ secrets.VPS_PORT }}"
        VPS_PASSWORD="${{ secrets.VPS_PASSWORD }}"
        
        echo "🚀 Deploying to PROD Environment..."
        echo "⚠️  PRODUCTION DEPLOYMENT - This will affect live users!"
        
        # Instalar sshpass
        sudo apt-get update
        sudo apt-get install -y sshpass
        
        # Criar diretório SSH se não existir
        mkdir -p ~/.ssh
        chmod 700 ~/.ssh
        touch ~/.ssh/known_hosts
        
        # Adicionar host conhecido
        ssh-keyscan -p $VPS_PORT $VPS_HOST >> ~/.ssh/known_hosts
        
        # Fazer backup completo do banco de produção
        sshpass -p "$VPS_PASSWORD" ssh -p $VPS_PORT -o StrictHostKeyChecking=no $VPS_USER@$VPS_HOST "cd /opt/secured-guard && docker exec secured-guard-db-prod pg_dump -U postgres secured_guard > backups/prod_backup_$(date +%Y%m%d_%H%M%S).sql"
        
        # Parar containers existentes
        sshpass -p "$VPS_PASSWORD" ssh -p $VPS_PORT -o StrictHostKeyChecking=no $VPS_USER@$VPS_HOST "cd /opt/secured-guard && docker-compose -f deploy/docker-compose.prod-domains.yml down" || true
        
        # Copiar código atualizado
        sshpass -p "$VPS_PASSWORD" rsync -avz --delete \
          --exclude='.git/' \
          --exclude='node_modules/' \
          --exclude='target/' \
          --exclude='*.log' \
          --exclude='uploads/' \
          --exclude='logs/' \
          --exclude='backups/' \
          -e "ssh -p $VPS_PORT -o StrictHostKeyChecking=no" \
          ./ $VPS_USER@$VPS_HOST:/opt/secured-guard/
        
        # Build e subir containers
        sshpass -p "$VPS_PASSWORD" ssh -p $VPS_PORT -o StrictHostKeyChecking=no $VPS_USER@$VPS_HOST "cd /opt/secured-guard && docker-compose -f deploy/docker-compose.prod-domains.yml up -d --build"
        
        # Aguardar serviços ficarem prontos
        sleep 30
        
        # Verificar status
        sshpass -p "$VPS_PASSWORD" ssh -p $VPS_PORT -o StrictHostKeyChecking=no $VPS_USER@$VPS_HOST "cd /opt/secured-guard && docker-compose -f deploy/docker-compose.prod-domains.yml ps"
        
        # Testar endpoints
        sshpass -p "$VPS_PASSWORD" ssh -p $VPS_PORT -o StrictHostKeyChecking=no $VPS_USER@$VPS_HOST "curl -f https://securedguard.z7botsolutions.com.br/api/actuator/health || echo 'Backend health check failed'"
        sshpass -p "$VPS_PASSWORD" ssh -p $VPS_PORT -o StrictHostKeyChecking=no $VPS_USER@$VPS_HOST "curl -f https://securedguard.z7botsolutions.com.br/ || echo 'Frontend health check failed'"
        
        echo "✅ PROD Environment deployed successfully!"
        echo "🌐 Access: https://securedguard.z7botsolutions.com.br"
        echo "📊 Backend API: https://securedguard.z7botsolutions.com.br/api"
