name: Deploy Alternative (SSH Fallback)

on:
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy'
        required: true
        default: 'prod'
        type: choice
        options:
        - prod
        - dev
        - ci
      force_deploy:
        description: 'Force deploy even if SSH fails'
        required: false
        default: false
        type: boolean

jobs:
  deploy-alternative:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Setup SSH and dependencies
      env:
        VPS_HOST: ${{ secrets.VPS_HOST }}
        VPS_SSH_PORT: ${{ secrets.VPS_SSH_PORT }}
      run: |
        echo "🔧 Configurando SSH e dependências..."
        
        # Install dependencies
        sudo apt-get update -y
        sudo apt-get install -y sshpass rsync curl
        
        # Setup SSH
        mkdir -p ~/.ssh
        chmod 700 ~/.ssh
        touch ~/.ssh/known_hosts
        chmod 600 ~/.ssh/known_hosts
        
        # Add VPS host key
        if [ -n "$VPS_HOST" ] && [ -n "$VPS_SSH_PORT" ]; then
          echo "🔑 Adicionando chave SSH da VPS: $VPS_HOST:$VPS_SSH_PORT"
          ssh-keyscan -p "$VPS_SSH_PORT" "$VPS_HOST" >> ~/.ssh/known_hosts || echo "⚠️ Aviso: Não foi possível adicionar chave SSH"
        fi
        
        echo "✅ SSH configurado!"
        
    - name: Test SSH connectivity
      env:
        VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
      run: |
        echo "🔍 Testando conectividade SSH..."
        
        # Test basic connectivity
        ping -c 3 ${{ secrets.VPS_HOST }} || echo "⚠️ Ping falhou"
        
        # Test SSH port
        nc -zv ${{ secrets.VPS_HOST }} ${{ secrets.VPS_SSH_PORT }} || echo "⚠️ Porta SSH inacessível"
        
        # Test SSH connection
        if sshpass -p "$VPS_PASSWORD" ssh -p ${{ secrets.VPS_SSH_PORT }} -o ConnectTimeout=10 -o StrictHostKeyChecking=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} "echo 'SSH OK'"; then
          echo "✅ SSH funcionando!"
          echo "SSH_OK=true" >> $GITHUB_ENV
        else
          echo "❌ SSH falhou"
          echo "SSH_OK=false" >> $GITHUB_ENV
        fi
        
    - name: Deploy via SSH (if working)
      if: env.SSH_OK == 'true'
      env:
        VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
      run: |
        echo "🚀 Deploy via SSH..."
        
        # Copy code to VPS
        sshpass -p "$VPS_PASSWORD" rsync -avz --delete \
          --exclude='.git/' \
          --exclude='node_modules/' \
          --exclude='target/' \
          --exclude='*.log' \
          --exclude='uploads/' \
          --exclude='logs/' \
          --exclude='backups/' \
          -e "ssh -p ${{ secrets.VPS_SSH_PORT }} -o StrictHostKeyChecking=no" \
          ./ ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }}:/opt/secured-guard/
        
        # Create .env file
        sshpass -p "$VPS_PASSWORD" ssh -p ${{ secrets.VPS_SSH_PORT }} -o StrictHostKeyChecking=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} "
          cd /opt/secured-guard
          cat > .env << 'EOF'
        POSTGRES_DB=secured_guard_prod
        POSTGRES_USER=postgressg
        POSTGRES_PASSWORD=S7UGKd%bnKW0!lhBA#BRJLCd!IpXvsnx
        POSTGRES_DB_DEV=secured_guard_dev
        POSTGRES_USER_DEV=postgressg
        POSTGRES_PASSWORD_DEV=S7UGKd%bnKW0!lhBA#BRJLCd!IpXvsnx
        POSTGRES_DB_CI=secured_guard_ci
        POSTGRES_USER_CI=postgressg
        POSTGRES_PASSWORD_CI=S7UGKd%bnKW0!lhBA#BRJLCd!IpXvsnx
        REDIS_PASSWORD=redis_secured_guard_2024
        JWT_SECRET=795927eaf0f77f4687edf8c7faaf30e2bd60d1c2215c0015ce9ddc83c8119615a3dec0755b6109a88d5077e6e4344a5b00be395e4c02a57ed923f95f1afebfed
        EOF
          chmod 600 .env
        "
        
        # Execute deploy script
        sshpass -p "$VPS_PASSWORD" ssh -p ${{ secrets.VPS_SSH_PORT }} -o StrictHostKeyChecking=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} "
          cd /opt/secured-guard
          chmod +x deploy/fix-backend.sh
          ./deploy/fix-backend.sh
        "
        
        # Check status
        sshpass -p "$VPS_PASSWORD" ssh -p ${{ secrets.VPS_SSH_PORT }} -o StrictHostKeyChecking=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} "
          cd /opt/secured-guard
          docker compose -f deploy/docker-compose.prod.yml ps
        "
        
        echo "✅ Deploy via SSH concluído!"
        
    - name: Alternative deployment (if SSH fails)
      if: env.SSH_OK == 'false' || github.event.inputs.force_deploy == 'true'
      run: |
        echo "🔄 Tentando deploy alternativo..."
        
        # Try different SSH configurations
        echo "Tentando configurações SSH alternativas..."
        
        # Try without password authentication
        if ssh -p ${{ secrets.VPS_SSH_PORT }} -o ConnectTimeout=10 -o StrictHostKeyChecking=no -o PasswordAuthentication=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} "echo 'SSH sem senha OK'"; then
          echo "✅ SSH sem senha funcionando!"
          echo "SSH_NO_PASS_OK=true" >> $GITHUB_ENV
        else
          echo "❌ SSH sem senha falhou"
          echo "SSH_NO_PASS_OK=false" >> $GITHUB_ENV
        fi
        
        # If all SSH methods fail, provide instructions
        if [ "$SSH_NO_PASS_OK" = "false" ]; then
          echo "❌ Todos os métodos SSH falharam"
          echo ""
          echo "📋 INSTRUÇÕES PARA CORREÇÃO MANUAL:"
          echo "=================================="
          echo ""
          echo "1. Acesse sua VPS via console/terminal:"
          echo "   ssh ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} -p ${{ secrets.VPS_SSH_PORT }}"
          echo ""
          echo "2. Execute os scripts de correção:"
          echo "   cd /opt/secured-guard"
          echo "   chmod +x deploy/fix-connectivity.sh"
          echo "   ./deploy/fix-connectivity.sh"
          echo ""
          echo "3. Ou execute o deploy manual:"
          echo "   chmod +x deploy/fix-backend.sh"
          echo "   ./deploy/fix-backend.sh"
          echo ""
          echo "4. Verifique o status:"
          echo "   docker compose -f deploy/docker-compose.prod.yml ps"
          echo ""
          echo "5. Teste a aplicação:"
          echo "   curl http://localhost:8080/actuator/health"
          echo ""
          echo "🔧 Problemas comuns:"
          echo "- Firewall bloqueando SSH"
          echo "- SSH daemon não rodando"
          echo "- Senha incorreta"
          echo "- Porta SSH incorreta"
          echo "- Chaves SSH mal configuradas"
        fi
        
    - name: Health check (if SSH worked)
      if: env.SSH_OK == 'true'
      env:
        VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
      run: |
        echo "🏥 Verificando saúde dos serviços..."
        
        # Wait for services to be ready
        sleep 30
        
        # Test backend health
        if sshpass -p "$VPS_PASSWORD" ssh -p ${{ secrets.VPS_SSH_PORT }} -o StrictHostKeyChecking=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} "curl -f http://localhost:8080/actuator/health"; then
          echo "✅ Backend funcionando!"
        else
          echo "❌ Backend com problemas"
        fi
        
        # Test frontend
        if sshpass -p "$VPS_PASSWORD" ssh -p ${{ secrets.VPS_SSH_PORT }} -o StrictHostKeyChecking=no ${{ secrets.VPS_USER }}@${{ secrets.VPS_HOST }} "curl -f http://localhost/"; then
          echo "✅ Frontend funcionando!"
        else
          echo "❌ Frontend com problemas"
        fi
        
    - name: Final status
      run: |
        echo "📊 STATUS FINAL DO DEPLOY"
        echo "========================"
        
        if [ "$SSH_OK" = "true" ]; then
          echo "✅ Deploy concluído com sucesso!"
          echo "🌐 Aplicação disponível em: http://${{ secrets.VPS_HOST }}"
          echo "🔧 Backend API: http://${{ secrets.VPS_HOST }}:8080"
        else
          echo "❌ Deploy falhou - SSH não funcionou"
          echo "📋 Execute as instruções acima para correção manual"
        fi
